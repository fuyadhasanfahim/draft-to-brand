# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- SMTP (required — powers the /contact form) ---------------------------
# Any SMTP provider works. For Gmail, SMTP_PASS must be a 16-character
# App Password (https://myaccount.google.com/apppasswords), not your login password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="you@example.com"
SMTP_PASS="your-smtp-app-password"
# Optional — "Name <email@domain>" sender header. Falls back to SMTP_USER if unset.
SMTP_FROM="Draft to Brand <noreply@drafttobrand.com>"

# --- MongoDB (required — stores /tools/brand-audit-checklist submissions) --
# Create a free cluster at https://www.mongodb.com/cloud/atlas, then paste its
# connection string here. Without this set, the audit tool still works for
# visitors — results just won't be saved.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/drafttobrand?retryWrites=true&w=majority"

# --- Analytics (optional — omit to disable) --------------------------------
# NEXT_PUBLIC_* vars are exposed to the browser bundle. Never put secrets here.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="000000000000000"

# --- Admin auth (required — protects /admin blog dashboard) ---------------
# Single admin user, no signup. Set ADMIN_EMAIL to the login email and
# ADMIN_PASSWORD_HASH to the value printed by:
#   node scripts/hash-password.mjs "your-plain-password"
# (It is a base64-encoded bcrypt hash — base64 so the "$" in a bcrypt hash is
#  not mangled by .env parsing. A raw "$2b$..." hash also works when set
#  directly in a hosting dashboard.)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH="paste_the_base64_value_from_the_script_here"
# Display name stamped on posts you publish (shown as the author byline).
ADMIN_NAME="Your Name"
# Secret used to sign the admin session cookie (JWT). Use a long random string:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace_with_long_random_string"

# --- Cloudinary (required — blog cover-image uploads) --------------------
# Free account at https://cloudinary.com. Cloud name is safe to expose; the
# API key/secret are server-only and used to sign uploads.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# --- Blog ads (optional) ------------------------------------------------
# Which network a plain [[ad]] token uses. Individual tokens can override
# with [[ad:adsense]] or [[ad:adsterra]].
NEXT_PUBLIC_DEFAULT_AD_NETWORK="adsense"

# Google AdSense. Publisher ID e.g. ca-pub-1234567890123456; SLOT is the
# in-article ad-unit id (AdSense > Ads > By ad unit). Both required for real
# ads; the account must be approved and the site needs a privacy policy.
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT=""

# Adsterra. From a Native Banner (recommended) or Banner ad unit, paste the
# invoke.js URL as _SRC and the unit key as _KEY (the snippet's
# container-<key> / 'key' value). Use only non-intrusive formats — popunder,
# Social Bar, and interstitials can get an AdSense account banned.
NEXT_PUBLIC_ADSTERRA_SRC=""
NEXT_PUBLIC_ADSTERRA_KEY=""

# --- Vercel (auto-managed) -------------------------------------------------
# VERCEL_OIDC_TOKEN is written automatically by `vercel env pull` / `vercel link`.
# Do not set this manually — the app does not read it.
